#!/usr/bin/env bash
# SessionStart hook for rails-agent-skills
#
# Emits the SessionStart hook payload with properly escaped JSON. The context
# string is passed through jq --arg so quotes, newlines, and backslashes are
# never interpreted as JSON structure. Falls back to a heredoc only if jq is
# unavailable (preserving prior behavior for minimal environments).

set -euo pipefail

session_context="Use the active project profile. For a clear task, load one matching skill. If routing is unclear, use the shared work-router from agnostic-planning-skills."

emit_with_jq() {
  if [ -n "${CLAUDE_PLUGIN_ROOT:-}" ]; then
    jq -n --arg ctx "$session_context" '{
      hookSpecificOutput: {
        hookEventName: "SessionStart",
        additionalContext: $ctx
      }
    }'
  else
    jq -n --arg ctx "$session_context" '{ additional_context: $ctx }'
  fi
}

emit_with_heredoc() {
  # Fallback: jq not installed. The static literal below contains no characters
  # that require JSON escaping, so heredoc emission is safe for this exact
  # string. If session_context ever becomes dynamic, require jq instead.
  if [ -n "${CLAUDE_PLUGIN_ROOT:-}" ]; then
    cat <<EOF
{
  "hookSpecificOutput": {
    "hookEventName": "SessionStart",
    "additionalContext": "${session_context}"
  }
}
EOF
  else
    cat <<EOF
{
  "additional_context": "${session_context}"
}
EOF
  fi
}

if command -v jq &>/dev/null; then
  emit_with_jq
else
  emit_with_heredoc
fi

exit 0
