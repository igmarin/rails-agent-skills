{
  "mcpServers": {
    "rails-agent-skills": {
      "type": "stdio",
      "command": "docker",
      "args": [
        "run", "--rm", "-i",
        "--pull", "always",
        "igmarin/rails-agent-skills-mcp:latest"
      ]
    },
    "rails-agent-skills-dev": {
      "type": "stdio",
      "command": "bundle",
      "args": [
        "exec",
        "ruby",
        "mcp_server/server.rb"
      ],
      "env": {
        "BUNDLE_GEMFILE": "mcp_server/Gemfile"
      }
    }
  }
}
