+++ b/app/services/orders/create_service.rb
@@ -0,0 +1,32 @@
+# frozen_string_literal: true
+
+module Orders
+  class CreateService
+    def self.call(params)
+      new(params).call
+    end
+
+    def initialize(params)
+      @params = params
+    end
+
+    def call
+      order = Order.new(@params)
+
+      if order.save
+        { success: true, response: { order: order } }
+      else
+        { success: false, response: { error: { message: order.errors.full_messages.join(", ") } } }
+      end
+    end
+  end
+end
diff --git a/spec/services/orders/create_service_spec.rb b/spec/services/orders/create_service_spec.rb
new file mode 100644
