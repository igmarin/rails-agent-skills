+++ b/spec/services/orders/create_service_spec.rb
@@ -0,0 +1,32 @@
+# frozen_string_literal: true
+
+require "rails_helper"
+
+RSpec.describe Orders::CreateService do
+  describe ".call" do
+    subject(:result) { described_class.call(params) }
+
+    let(:params) { { customer_name: "Alice", total: 99.99 } }
+
+    context "with valid params" do
+      it "returns a success response with the created order" do
+        expect(result[:success]).to be true
+        expect(result[:response][:order]).to be_an(Order)
+      end
+
+      it "creates a new order" do
+        expect { result }.to change(Order, :count).by(1)
+      end
+    end
+
+    context "with invalid params" do
+      let(:params) { { customer_name: "" } }
+
+      it "returns a failure response with error messages" do
+        expect(result[:success]).to be false
+        expect(result[:response][:error][:message]).to be_present
+      end
+    end
+  end
+end
